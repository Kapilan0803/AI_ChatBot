# ── Which AI provider to use by default: gemini | groq | ollama ──
# (You can also switch provider in the app sidebar at any time.)
LLM_PROVIDER=gemini

# ── Google Gemini: free key, no credit card -> https://aistudio.google.com/apikey ──
GOOGLE_API_KEY=your_google_api_key_here

# ── Optional: Groq key -> https://console.groq.com ──
# GROQ_API_KEY=your_groq_api_key_here

# ── Optional: Ollama (runs on your own computer, no key needed) ──
# Install from https://ollama.com, then run:  ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ── Optional: override the default model of a provider ──
# Free-tier model names change often; if one stops working, set a new one here.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-20b
# OLLAMA_MODEL=llama3.2

# ── Optional: LangSmith tracing. Keep commented out unless you have a real key. ──
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=AI_Chatbot_Suite
